# MODEL API
# API key for the LLM service (e.g. OpenAI, Anthropic). Read by litellm in core.models
MODEL_API_KEY=sk-xxxx-example-key

# DATABASE
# Which database backend to use: duckdb or postgres. Read by backend.core.config
DATABASE_BACKEND=duckdb
# Database connection string. Read by backend.storage.results_db
DATABASE_URL=./data/metacog.duckdb

# APP CONFIG
# Path to task definition JSONL files. Read by backend.task_registry.task_loader
TASK_BANK_PATH=./backend/task_registry/tasks
# Minimum confidence threshold for heuristics. Read by backend.core.config
CONFIDENCE_THRESHOLD=0.85

# EVALUATION CONFIG
# Enable or disable adversarial pressure tests. Read by backend.core.config
ADVERSARIAL_PRESSURE_ENABLED=True
# Percentage of tasks to apply adversarial pressure. Read by backend.core.config
ADVERSARIAL_SAMPLE_RATE=0.30
# Number of bins for Expected Calibration Error. Read by backend.evaluation.calibration_engine
CALIBRATION_N_BINS=10

# AUTH
# Secret key for JWT signing. Read by core.auth / config
JWT_SECRET=super_secret_jwt_token_for_internal_auth_only
# Token expiration time. Read by core.auth
JWT_EXPIRE_MINUTES=480

# REPORTING / MLFLOW
# MLflow tracking server URI. Read by backend.storage.version_manager
MLFLOW_TRACKING_URI=http://localhost:5000

# LOGGING
# Logging level (DEBUG, INFO, WARNING, ERROR). Read by backend.core.logging_config
LOG_LEVEL=INFO
# Logging format: json or text. Read by backend.core.logging_config
LOG_FORMAT=json
